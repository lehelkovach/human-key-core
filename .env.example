HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
UPLOAD_LIMIT=1mb

# Defaults to dry-run mode. Set false only on a secured dev VM with OAuth credentials.
QUICKBOOKS_DRY_RUN=true
INTUIT_ENVIRONMENT=sandbox
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=
INTUIT_ACCESS_TOKEN=
INTUIT_REFRESH_TOKEN=
PREAUTH_AMOUNT=1.00
PREAUTH_CURRENCY=USD

# Oracle Cloud inputs used by scripts/oci/ensure-dev-vm.sh.
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_COMPARTMENT_OCID=
OCI_REGION=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_B64=
OCI_API_PUBLIC_KEY=
OCI_SHAPE=VM.Standard.E2.1.Micro
OCI_INSTANCE_DISPLAY_NAME=intuit-card-dev
OCI_PROJECT_REPO=intuit-card
